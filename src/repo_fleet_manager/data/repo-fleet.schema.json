            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_type": {
                  "const": "upstream"
                }
              },
              "required": [
                "source_type"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "upstream_url"
                  ]
                },
                {
                  "required": [
                    "source_url"
                  ]
                },
                {
                  "required": [
                    "clone_url"
                  ]
                },
                {
                  "required": [
                    "fork_from"
                  ]
                },
                {
                  "required": [
                    "mirror_source"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "remote_mode": {
                  "const": "fork"
                }
              },
              "required": [
                "remote_mode"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "fork_from"
                  ]
                },
                {
                  "required": [
                    "upstream_url"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source_type": {
                  "const": "existing"
