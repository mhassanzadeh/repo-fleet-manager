          "owner": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "url_template": {
            "type": "string",
            "minLength": 1
          },
          "cli": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string"
