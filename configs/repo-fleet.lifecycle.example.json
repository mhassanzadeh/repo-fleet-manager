{
  "project": {
    "name": "mixed-platform",
    "default_provider": "github",
    "default_branch": "main",
    "env_prefix": "MIXED",
    "build_dir": ".repo-fleet/build"
  },
  "providers": {
    "github": {
      "namespace": "my-github-user",
      "host": "github.com",
      "cli": "gh",
      "url_template": "git@github.com:{namespace}/{repo}.git",
      "type": "remote",
      "driver": "github",
      "required_scopes": []
    },
    "gitlab": {
      "namespace": "my-gitlab-group",
      "host": "gitlab.com",
      "cli": "glab",
      "url_template": "git@gitlab.com:{namespace}/{repo}.git",
      "type": "remote",
      "driver": "gitlab",
      "required_scopes": []
    },
    "local": {
      "type": "local",
      "namespace": ".repo-fleet/remotes",
      "cli": "git",
      "url_template": "file://{root}/{namespace}/{repo}.git",
      "driver": "local",
      "required_scopes": []
    }
  },
  "local": {
    "remotes_dir": ".repo-fleet/remotes",
    "workspace_mode": "submodules",
    "operations_dir": ".repo-fleet/operations",
    "lock_file": ".repo-fleet/lock",
    "default_jobs": 1,
    "backups_dir": ".repo-fleet/backups",
    "backup_retention": 5,
    "backup_include_operations": false,
    "cache_dir": ".repo-fleet/cache",
    "cache_retention": 3
  },
  "repositories": [
    {
      "path": ".",
      "repo": "mixed-platform",
      "kind": "root",
      "provider": "github",
      "branch": "main",
      "source_type": "new",
      "description": "Root orchestration repository",
      "depends_on": [],
      "remote_mode": "create"
    },
    {
      "path": "apps/custom-app",
      "repo": "mixed-custom-app",
      "kind": "service",
      "provider": "github",
      "branch": "main",
      "source_type": "new",
      "description": "New app that does not exist anywhere yet",
      "depends_on": [
        "frappe",
        "erpnext"
      ],
      "remote_mode": "create"
    },
    {
      "path": "vendor/frappe",
      "repo": "frappe",
      "kind": "module",
      "provider": "github",
      "branch": "version-15",
      "source_type": "upstream",
      "remote_mode": "mirror",
      "upstream_url": "https://github.com/frappe/frappe.git",
      "description": "External upstream that is localized as a mirror",
      "depends_on": []
    },
    {
      "path": "vendor/erpnext",
      "repo": "erpnext",
      "kind": "module",
      "provider": "github",
      "branch": "version-15",
      "source_type": "upstream",
      "remote_mode": "fork",
      "fork_from": "https://github.com/frappe/erpnext.git",
      "description": "External upstream intended for fork/mirror workflows",
      "depends_on": []
    },
    {
      "path": "legacy/tenant-admin",
      "repo": "mixed-tenant-admin",
      "kind": "service",
      "provider": "github",
      "branch": "main",
      "source_type": "existing",
      "existing_path": "../old-projects/tenant-admin",
      "description": "Already-built local project to import and publish",
      "depends_on": [
        "mixed-custom-app"
      ],
      "remote_mode": "create"
    }
  ],
  "compose": {
    "file": "infra-compose/docker-compose.yml",
    "project_name": "mixed-platform",
    "cache_images": []
  },
  "fingerprint": {
    "algorithm": "sha256",
    "short_length": 16
  },
  "schema_version": "1.0.0",
  "observability": {
    "logs_dir": ".repo-fleet/logs",
    "audit_enabled": true,
    "retention_days": 30,
    "include_output": true
  },
  "supply_chain": {
    "output_dir": ".repo-fleet/supply-chain",
    "engine": "auto",
    "digest_resolver": "auto",
    "sbom_format": "cyclonedx-json",
    "vulnerability_threshold": "high",
    "require_immutable_digest": true,
    "require_source_label": true,
    "require_sbom": true,
    "require_scan": false,
    "require_signature": false,
    "require_attestation": false,
    "cosign": {}
  },
  "policy": {
    "enabled": true,
    "mode": "check",
    "fail_on": "error",
    "rules": [
      {
        "id": "approved-repository-visibility",
        "type": "repository.visibility",
        "severity": "error",
        "parameters": {
          "allowed": [
            "private",
            "internal"
          ]
        },
        "description": "Repositories must not be public unless explicitly excepted."
      },
      {
        "id": "approved-image-registries",
        "type": "supply-chain.registry",
        "severity": "error",
        "parameters": {
          "allowed_registries": [
            "docker.io",
            "ghcr.io",
            "quay.io",
            "registry.example.com"
          ]
        }
      },
      {
        "id": "destructive-operation-reason",
        "type": "operation.guard",
        "severity": "error",
        "parameters": {
          "actions": [
            "repos publish",
            "repos mirror",
            "compose down",
            "local restore",
            "cache import",
            "cache bootstrap"
          ],
          "require_reason": true
        }
      }
    ],
    "exceptions": []
  }
}
