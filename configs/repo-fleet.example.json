{
  "project": {
    "name": "my-platform",
    "default_provider": "github",
    "default_branch": "main",
    "env_prefix": "MYAPP",
    "build_dir": ".repo-fleet/build"
  },
  "providers": {
    "github": {
      "namespace": "my-github-org",
      "host": "github.com",
      "cli": "gh",
      "url_template": "git@github.com:{namespace}/{repo}.git",
      "type": "remote",
      "driver": "github",
      "required_scopes": []
    },
    "gitlab": {
      "namespace": "my-gitlab-group",
      "host": "gitlab.com",
      "cli": "glab",
      "url_template": "git@gitlab.com:{namespace}/{repo}.git",
      "type": "remote",
      "driver": "gitlab",
      "required_scopes": []
    },
    "local": {
      "type": "local",
      "namespace": ".repo-fleet/remotes",
      "cli": "git",
      "url_template": "file://{root}/{namespace}/{repo}.git",
      "driver": "local",
      "required_scopes": []
    }
  },
  "compose": {
    "file": "infra-compose/docker-compose.yml",
    "env_file": "infra-compose/.env.example",
    "project_name": "infra-compose",
    "cache_images": []
  },
  "fingerprint": {
    "algorithm": "sha256",
    "short_length": 16
  },
  "repositories": [
    {
      "path": ".",
      "repo": "my-platform",
      "kind": "root",
      "provider": "github",
      "branch": "main",
      "description": "Root orchestration repository",
      "source_type": "new",
      "depends_on": [],
      "remote_mode": "create",
      "tags": [
        "root",
        "orchestration"
      ]
    },
    {
      "path": "services/api",
      "repo": "my-api-service",
      "kind": "service",
      "provider": "github",
      "branch": "main",
      "host_port": 8080,
      "compose_service": "api",
      "docker_context": "services/api",
      "dockerfile": "services/api/Dockerfile",
      "health_url": "http://localhost:8080/healthz",
      "source_type": "new",
      "depends_on": [
        "my-shared-contracts"
      ],
      "remote_mode": "create",
      "tags": [
        "backend",
        "runtime"
      ]
    },
    {
      "path": "clients/web",
      "repo": "my-web-client",
      "kind": "client",
      "provider": "github",
      "branch": "main",
      "source_type": "new",
      "depends_on": [
        "my-shared-contracts",
        "my-api-service"
      ],
      "remote_mode": "create",
      "tags": [
        "frontend",
        "runtime"
      ]
    },
    {
      "path": "packages/contracts",
      "repo": "my-shared-contracts",
      "kind": "package",
      "provider": "github",
      "branch": "main",
      "source_type": "new",
      "depends_on": [],
      "remote_mode": "create",
      "tags": [
        "shared",
        "library"
      ]
    }
  ],
  "local": {
    "remotes_dir": ".repo-fleet/remotes",
    "workspace_mode": "submodules",
    "operations_dir": ".repo-fleet/operations",
    "lock_file": ".repo-fleet/lock",
    "default_jobs": 1,
    "backups_dir": ".repo-fleet/backups",
    "backup_retention": 5,
    "backup_include_operations": false,
    "cache_dir": ".repo-fleet/cache",
    "cache_retention": 3
  },
  "schema_version": "1.0.0",
  "profiles": {
    "developer": {
      "project": {
        "default_provider": "local"
      },
      "local": {
        "default_jobs": 2
      },
      "compose": {
        "project_name": "my-platform-dev"
      },
      "providers": {
        "local": {
          "namespace": ".repo-fleet/dev-remotes"
        }
      }
    },
    "ci": {
      "extends": "developer",
      "project": {
        "default_provider": "github"
      },
      "local": {
        "default_jobs": 4
      },
      "compose": {
        "project_name": "my-platform-ci"
      },
      "repositories": {
        "my-web-client": {
          "enabled": false
        }
      }
    },
    "production": {
      "project": {
        "default_provider": "github"
      },
      "local": {
        "default_jobs": 8
      },
      "repositories": {
        "my-api-service": {
          "branch": "stable"
        },
        "my-web-client": {
          "branch": "stable"
        }
      }
    }
  },
  "groups": {
    "backend": {
      "tags": [
        "backend"
      ],
      "include_dependencies": true
    },
    "frontend": {
      "tags": [
        "frontend"
      ],
      "include_dependencies": true
    },
    "runtime": {
      "tags": [
        "runtime"
      ],
      "include_dependencies": true
    },
    "shared": [
      "my-shared-contracts"
    ]
  },
  "runtime": {
    "timeout_seconds": 120,
    "interval_seconds": 2,
    "log_tail": 80,
    "default_running_is_ready": true,
    "services": {
      "api": {
        "required": true,
        "depends_on": [],
        "probe": {
          "type": "http",
          "url": "http://localhost:8080/healthz",
          "expected_status": [
            200,
            204
          ],
          "timeout_seconds": 3
        }
      }
    }
  },
  "observability": {
    "logs_dir": ".repo-fleet/logs",
    "audit_enabled": true,
    "retention_days": 30,
    "include_output": true
  },
  "supply_chain": {
    "output_dir": ".repo-fleet/supply-chain",
    "engine": "auto",
    "digest_resolver": "auto",
    "sbom_format": "cyclonedx-json",
    "vulnerability_threshold": "high",
    "require_immutable_digest": true,
    "require_source_label": true,
    "require_sbom": true,
    "require_scan": false,
    "require_signature": false,
    "require_attestation": false,
    "cosign": {}
  },
  "policy": {
    "enabled": true,
    "mode": "check",
    "fail_on": "error",
    "rules": [
      {
        "id": "approved-repository-visibility",
        "type": "repository.visibility",
        "severity": "error",
        "parameters": {
          "allowed": [
            "private",
            "internal"
          ]
        },
        "description": "Repositories must not be public unless explicitly excepted."
      },
      {
        "id": "approved-image-registries",
        "type": "supply-chain.registry",
        "severity": "error",
        "parameters": {
          "allowed_registries": [
            "docker.io",
            "ghcr.io",
            "quay.io",
            "registry.example.com"
          ]
        }
      },
      {
        "id": "destructive-operation-reason",
        "type": "operation.guard",
        "severity": "error",
        "parameters": {
          "actions": [
            "repos publish",
            "repos mirror",
            "compose down",
            "local restore",
            "cache import",
            "cache bootstrap"
          ],
          "require_reason": true
        }
      }
    ],
    "exceptions": []
  }
}
