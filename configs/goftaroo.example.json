{
  "project": {
    "name": "goftaroo-platform",
    "default_provider": "github",
    "default_branch": "main",
    "env_prefix": "GOFTAROO",
    "build_dir": ".repo-fleet/build"
  },
  "providers": {
    "github": {
      "namespace": "mhassanzadeh",
      "host": "github.com",
      "cli": "gh",
      "url_template": "git@github.com:{namespace}/{repo}.git",
      "type": "remote",
      "driver": "github",
      "required_scopes": []
    },
    "gitlab": {
      "namespace": "goftaroo",
      "host": "gitlab.com",
      "cli": "glab",
      "url_template": "git@gitlab.com:{namespace}/{repo}.git",
      "type": "remote",
      "driver": "gitlab",
      "required_scopes": []
    },
    "local": {
      "type": "local",
      "namespace": ".repo-fleet/remotes",
      "cli": "git",
      "url_template": "file://{root}/{namespace}/{repo}.git",
      "driver": "local",
      "required_scopes": []
    }
  },
