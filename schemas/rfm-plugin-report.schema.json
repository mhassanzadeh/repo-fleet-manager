{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhassanzadeh/repo-fleet-manager/schemas/rfm-plugin-report.schema.json",
  "title": "Repo Fleet Manager plugin diagnostic report",
  "type": "object",
  "required": ["api_version", "enabled", "strict", "plugin_count", "healthy", "records"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "enabled": {"type": "boolean"},
    "strict": {"type": "boolean"},
    "plugin_count": {"type": "integer", "minimum": 0},
    "healthy": {"type": "boolean"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "name", "entry_point", "builtin", "loaded", "aliases", "capabilities"],
        "additionalProperties": true,
        "properties": {
          "kind": {"enum": ["provider", "runtime", "catalog-exporter", "artifact-backend"]},
          "name": {"type": "string", "minLength": 1},
          "entry_point": {"type": "string", "minLength": 1},
          "builtin": {"type": "boolean"},
          "loaded": {"type": "boolean"},
          "compatible": {"type": ["boolean", "null"]},
          "api_version": {"type": ["string", "null"]},
          "plugin_version": {"type": ["string", "null"]},
          "description": {"type": ["string", "null"]},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "capabilities": {"type": "object"},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
